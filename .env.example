# ==============================================================================
# StateGuard Extension — Environment Configuration Example
# ==============================================================================
# Copy this file to .env or set these in your local environment.
# StateGuard supports ambient zero-friction credentials or direct API keys.

# ------------------------------------------------------------------------------
# 1. Google Gemini API Configuration
# ------------------------------------------------------------------------------
# Google Gen AI SDK API key for gemini-3.8-flash validation sweeps.
# Obtain a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# For Vite client-side direct access (optional, if running standalone web mode)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. StateGuard Engine & Reasoning Parameters
# ------------------------------------------------------------------------------
# Default model code (gemini-3.8-flash is the primary engine)
STATEGUARD_MODEL=gemini-3.8-flash

# Dynamic thinking effort parameter: 'low', 'medium', or 'high'
# 'medium' is the recommended default for automated anti-drift validation sweeps
STATEGUARD_THINKING_EFFORT=medium

# ------------------------------------------------------------------------------
# 3. Privacy & Ephemeral Encryption Settings
# ------------------------------------------------------------------------------
# Optional master passphrase for client-side PBKDF2 / AES-GCM 256-bit key derivation.
# Defaults to a randomized local ephemeral key if not specified.
STATEGUARD_MASTER_PASSPHRASE=stateguard-ephemeral-local-key

# Default session Time-To-Live auto-purge policy: 'session', '1h', '24h', '7d', 'never'
STATEGUARD_DEFAULT_TTL=24h

# ------------------------------------------------------------------------------
# 4. Freemium Monetization & License Keys
# ------------------------------------------------------------------------------
# Default tier is 'free' (capped at 50 checkpoints/month).
# Provide a Pro license key (e.g., SG-PRO-XXXX-XXXX) to unlock unlimited checkpoints.
# Test bypass key: SG-PRO-UNLIMITED-TEST
STATEGUARD_LICENSE_KEY=SG-PRO-UNLIMITED-TEST
