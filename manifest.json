{
  "manifest_version": 3,
  "name": "StateGuard: AI Session Tree & Validation Guard",
  "version": "1.0.0",
  "description": "Zero-friction visual Git-style branching, one-click checkpoints/rollbacks, and Gemini 3.8 Flash automated reasoning validation sweeps for AI chats.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open StateGuard Console",
    "default_popup": "sidepanel.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
